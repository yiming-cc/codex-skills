#!/usr/bin/env python3
# container-setup personal directory entry point
"""Initialize a mounted personal directory and attach this container's HOME."""
import argparse
from contextlib import ExitStack
import fcntl
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

DEFAULT_DIRS = (".codex", ".ssh", ".config/gh", ".local/bin")
BACKUPS = ".container-setup-backups"
LOCK = ".container-setup.lock"
BASH_INIT = r'''
# BEGIN container-setup
case ":${PATH-}:" in
    *:"$HOME/.local/bin":*) ;;
    *) export PATH="$HOME/.local/bin${PATH:+:$PATH}" ;;
esac
if ! command -v codex >/dev/null 2>&1 && [ "$(uname -m)" = x86_64 ] &&
    [ -x "$HOME/.codex/packages/app-server-daemon/current/bin/codex" ]; then
    export PATH="$HOME/.codex/packages/app-server-daemon/current/bin:$PATH"
fi
# END container-setup
'''
PAI_BASH = r'''
# BEGIN container-setup aliyun-pai
if [ -x "$HOME/.local/bin/pai" ] && [ -d "$HOME/.config/aliyun-pai/cli" ]; then
    export PAI_CLI_BIN="$HOME/.local/bin/pai"
    export PAI_CONFIG_DIR="$HOME/.config/aliyun-pai/cli"
    case ":${PATH-}:" in
        *:"$HOME/.local/bin":*) ;;
        *) export PATH="$HOME/.local/bin${PATH:+:$PATH}" ;;
    esac
fi
# END container-setup aliyun-pai
'''


def exists(path):
    return os.path.lexists(path)


def contains(parent, path):
    return path == parent or parent in path.parents


def read_dirs(volume, with_pai):
    manifest = volume / "setup.paths"
    lines = manifest.read_text().splitlines() if exists(manifest) else DEFAULT_DIRS
    dirs = []
    reserved = {BACKUPS, LOCK, ".bashrc", "setup", "setup.d", "setup.paths"}
    for line in lines:
        name = line.strip()
        if not name or name.startswith("#"):
            continue
        path = Path(name)
        if (path.is_absolute() or not path.parts or ".." in path.parts
                or path.parts[0] in reserved):
            raise ValueError(f"invalid directory in setup.paths: {name}")
        if any(contains(other, path) or contains(path, other) for other in dirs):
            raise ValueError(f"overlapping directories in setup.paths: {name}")
        dirs.append(path)
    if with_pai:
        for path in (Path(".config/aliyun-pai"), Path(".local/bin")):
            if not any(contains(other, path) for other in dirs):
                dirs = [other for other in dirs if not contains(path, other)]
                dirs.append(path)
    return dirs


def check_paths(home, volume, names):
    for name in names:
        local, shared = home / name, volume / name
        if contains(local, volume) or contains(local.parent.resolve() / local.name, volume):
            raise ValueError(f"personal directory lies inside {local}")
        if shared.parent.resolve() != shared.parent or shared.is_symlink():
            raise ValueError(f"persistent path traverses a symlink: {shared}")
        # A container may already link the whole parent (e.g. ~/.config).
        if local.parent.resolve() != local.parent and local.parent.resolve() != shared.parent:
            raise ValueError(f"HOME parent points elsewhere: {local.parent}")
        expected_file = name == Path(".bashrc")
        if exists(shared):
            valid = shared.is_file() if expected_file else shared.is_dir()
            if not valid:
                raise ValueError(f"unexpected persistent entry type: {shared}")
        elif exists(local):
            if local.is_symlink() and local.resolve() == shared:
                continue
            valid = local.is_file() if expected_file else local.is_dir()
            if not valid or contains(local.resolve(), shared):
                raise ValueError(f"cannot seed from {local}")


def relocate_home_links(staged, shared, home, volume, names):
    # Keep links between persisted entries usable when the next HOME differs.
    def walk_error(error):
        raise error

    for parent, dirs, files in os.walk(staged, onerror=walk_error):
        for item in dirs + files:
            link = Path(parent) / item
            if not link.is_symlink():
                continue
            target = Path(os.readlink(link))
            if not contains(home, target) or ".." in target.parts:
                continue
            relative = target.relative_to(home)
            if any(contains(name, relative) for name in names):
                final_parent = shared / link.parent.relative_to(staged)
                link.unlink()
                link.symlink_to(os.path.relpath(volume / relative, final_parent))


def seed(home, volume, name, names):
    local, shared = home / name, volume / name
    bashrc = name == Path(".bashrc")
    shared.parent.mkdir(parents=True, exist_ok=True)
    # Publish only a complete copy on the same filesystem as its destination.
    with tempfile.TemporaryDirectory(prefix=".container-setup-", dir=shared.parent) as tmp:
        staged = Path(tmp) / "entry"
        if local.exists():
            subprocess.run(["cp", "-aH", "--", local, staged], check=True)
            if not bashrc:
                relocate_home_links(staged, shared, home, volume, names)
        elif bashrc:
            staged.touch(mode=0o600)
        else:
            staged.mkdir(mode=0o700)
        if bashrc:
            if b"# BEGIN container-setup" not in staged.read_bytes().splitlines():
                mode = staged.stat().st_mode & 0o777
                staged.chmod(mode | 0o200)
                with staged.open("ab") as stream:
                    stream.write(BASH_INIT.encode())
                staged.chmod(mode)
        elif shared.name in (".ssh", ".codex", "gh", "aliyun-pai"):
            staged.chmod(0o700)
        staged.rename(shared)


def seed_missing(home, volume, names, preview):
    # A HOME entry may resolve through another one (e.g. a linked .bashrc).
    # Import every missing item before changing any of those source paths.
    for name in names:
        local, shared = home / name, volume / name
        if not exists(shared):
            print(f"seed {shared} from {local}" if local.exists() else f"create {shared}")
            if not preview:
                seed(home, volume, name, names)


def attach(home, volume, names, preview):
    backup = None
    for name in names:
        local, shared = home / name, volume / name
        if local.resolve() == shared:
            print(f"attached {local}")
            continue
        print(f"link {local} -> {shared}")
        if preview:
            if exists(local):
                print(f"  back up {local} under {home / BACKUPS}")
            continue
        local.parent.mkdir(parents=True, exist_ok=True)
        saved = None
        if exists(local):
            if backup is None:
                base = home / BACKUPS
                if base.is_symlink():
                    raise ValueError(f"backup directory is a symlink: {base}")
                base.mkdir(mode=0o700, exist_ok=True)
                backup = Path(tempfile.mkdtemp(prefix="run-", dir=base))
            saved = backup / name
            saved.parent.mkdir(parents=True, exist_ok=True)
            local.rename(saved)
            print(f"  backup {saved}", flush=True)
        try:
            local.symlink_to(shared)
        except OSError:
            if saved is not None and not exists(local):
                saved.rename(local)
            raise


def install_staged(staged, dest, volume):
    saved = None
    if exists(dest):
        directory = Path(tempfile.mkdtemp(prefix=".container-setup-backup-", dir=volume))
        saved = directory / dest.name
        dest.rename(saved)
        print(f"backup {dest} -> {saved}", flush=True)
    try:
        staged.rename(dest)
    except OSError:
        if saved is not None and not exists(dest):
            saved.rename(dest)
        raise


def persistent_script(script, volume, preview):
    if contains(volume, script):
        return script
    # The bootstrap skill can live in a disposable container HOME.
    package = script.parent.parent
    installed = volume / ".codex/skills/container-setup"
    if not contains(volume, installed.parent.resolve()):
        raise ValueError(f"skill directory points outside the volume: {installed.parent}")
    files = ("SKILL.md", "scripts/setup", "scripts/pai-cli.sh")
    if (contains(volume, installed.resolve())
            and all((installed / name).is_file()
                    and (installed / name).read_bytes() == (package / name).read_bytes()
                    for name in files)
            and os.access(installed / "scripts/setup", os.X_OK)):
        return (installed / "scripts/setup").resolve()
    print(f"install skill {installed}")
    if not preview:
        installed.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(dir=installed.parent) as tmp:
            staged = Path(tmp) / "container-setup"
            (staged / "scripts").mkdir(parents=True)
            for name in files:
                shutil.copy2(package / name, staged / name)
            install_staged(staged, installed, volume)
    return installed / "scripts/setup"


def install_entry(volume, script, preview):
    setup = volume / "setup"
    target = os.path.relpath(script, volume)
    if setup.is_symlink() and os.readlink(setup) == target:
        return
    print(f"link {setup} -> {target}")
    if not preview:
        with tempfile.TemporaryDirectory(dir=volume) as tmp:
            staged = Path(tmp) / "setup"
            staged.symlink_to(target)
            install_staged(staged, setup, volume)


def configure_pai_shell(volume):
    rc = volume / ".bashrc"
    lines = rc.read_bytes().splitlines()
    if b"# BEGIN container-setup aliyun-pai" in lines:
        return
    with tempfile.TemporaryDirectory(dir=volume) as tmp:
        staged = Path(tmp) / ".bashrc"
        shutil.copy2(rc, staged)
        mode = staged.stat().st_mode & 0o777
        staged.chmod(mode | 0o200)
        with staged.open("ab") as stream:
            stream.write(PAI_BASH.encode())
        staged.chmod(mode)
        staged.replace(rc)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    invoked = Path(__file__).absolute()
    script = invoked.resolve()
    parser.add_argument("--personal", type=Path, help="existing mounted personal directory")
    parser.add_argument("--dry-run", action="store_true", help="print actions without writing or running hooks")
    parser.add_argument("--all", action="store_true", help="enable all optional setup steps, including Aliyun PAI")
    parser.add_argument("--with-aliyun-pai", action="store_true",
                        help="install the PAI CLI and attach its configuration")
    args = parser.parse_args()
    with_pai = args.all or args.with_aliyun_pai
    if args.personal is None and invoked.parent.resolve() == script.parent:
        parser.error("supply --personal when invoking the skill's initializer")
    volume = (args.personal or invoked.parent).expanduser().resolve(strict=True)
    home = Path.home().resolve(strict=True)
    if not volume.is_dir() or contains(volume, home) or contains(home / BACKUPS, volume):
        raise ValueError(f"invalid personal directory for HOME {home}: {volume}")

    setup = volume / "setup"
    hooks = volume / "setup.d"
    manifest = volume / "setup.paths"
    with ExitStack() as locks:
        if not args.dry_run:
            for directory in (home, volume):
                fd = os.open(directory / LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
                locks.callback(os.close, fd)
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    raise ValueError(f"another setup is using {directory}")
        if exists(manifest) and (manifest.is_symlink() or not manifest.is_file()):
            raise ValueError(f"expected a regular file: {manifest}")
        if exists(hooks) and (hooks.is_symlink() or not hooks.is_dir()):
            raise ValueError(f"expected a directory: {hooks}")
        if exists(setup) and not (setup.is_file() or setup.is_symlink()):
            raise ValueError(f"invalid setup entry point: {setup}")
        names = [*read_dirs(volume, with_pai), Path(".bashrc")]
        check_paths(home, volume, names)
        if not exists(manifest):
            print(f"create {manifest}")
            if not args.dry_run:
                with tempfile.TemporaryDirectory(dir=volume) as tmp:
                    paths = Path(tmp) / "setup.paths"
                    paths.write_text("\n".join(DEFAULT_DIRS) + "\n")
                    paths.rename(manifest)
        if not exists(hooks):
            print(f"create {hooks}")
            if not args.dry_run:
                hooks.mkdir(mode=0o700)
        seed_missing(home, volume, names, args.dry_run)
        canonical = persistent_script(script, volume, args.dry_run)
        install_entry(volume, canonical, args.dry_run)
        attach(home, volume, names, args.dry_run)

        steps = {hook.name: hook for hook in hooks.iterdir()
                 if hook.is_file() and hook.suffix in (".sh", ".py")} if hooks.is_dir() else {}
        # Existing volumes may already have this installer in setup.d.
        pai_step = "25-pai-cli.sh"
        if with_pai:
            steps.setdefault(pai_step, canonical.with_name("pai-cli.sh"))
        else:
            steps.pop(pai_step, None)
        for name, hook in sorted(steps.items()):
            print(f"run {hook}", flush=True)
            if not args.dry_run:
                interpreter = "bash" if hook.suffix == ".sh" else sys.executable
                subprocess.run([interpreter, hook, volume], cwd=volume, check=True)
                if name == pai_step:
                    configure_pai_shell(volume)


if __name__ == "__main__":
    os.umask(0o077)
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        sys.exit(f"container-setup: {error}")
