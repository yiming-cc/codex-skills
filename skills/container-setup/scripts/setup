#!/usr/bin/env bash
# Keep the invoked path so the personal disk's symlink identifies the volume.
if python3 "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/setup.py" "${BASH_SOURCE[0]}" "$@"; then
    : # Help or preview completed.
else
    case $? in
        10)
            if [[ ${BASH_SOURCE[0]} == "$0" && -t 0 && -t 2 ]]; then
                exec bash --noprofile --norc -ic 'source "$HOME/.bashrc"'
            fi
            source "$HOME/.bashrc"
            ;;
        *) (exit "$?") ;; # Preserve initialization errors in both invocation modes.
    esac
fi
